# Profile: cloud (hosted services, the default) or local (everything on this machine).
# `evolora agent` sets local automatically.
EVOLORA_PROFILE=cloud

# --- Local profile (ignored by the cloud profile) ---
# llama.cpp server binary; EvoLoRA starts, swaps and stops it as needed.
LLAMA_SERVER_PATH=
# Catalog key from `evolora setup --list`, or set LOCAL_LLM_MODEL_PATH to any GGUF file.
LOCAL_LLM_MODEL=qwen3-4b-instruct
LOCAL_LLM_MODEL_PATH=
# Optional independent judge (blank = same model as the planner).
LOCAL_JUDGE_MODEL=
LOCAL_JUDGE_MODEL_PATH=
LOCAL_MODELS_DIR=./models
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# false = you run llama-server / LM Studio yourself at LOCAL_LLM_BASE_URL
LOCAL_LLM_MANAGED=true
LOCAL_LLM_CTX=8192
LOCAL_LLM_GPU_LAYERS=99
LOCAL_LLM_EXTRA_ARGS=
LOCAL_LLM_TIMEOUT_S=900
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_EXAMPLE_BATCH_SIZE=8
# Run history; the local profile defaults to ./evolora.db
EVOLORA_DB_PATH=
# On-device training. The local profile defaults to TRAINING_BACKEND=local and
# MODEL_RUNNER=local; set both to mock for a quick dry run without the GPU.
# Interpreter with torch (XPU/CUDA), transformers, peft, trl (see
# scripts/bench/requirements-xpu.txt). Blank = .venv-train, then .venv-bench.
LOCAL_TRAIN_PYTHON=
LOCAL_WORKSPACE_DIR=./workspace
LOCAL_ADAPTERS_DIR=./adapters
LOCAL_MAX_SEQ_LEN=512
LOCAL_MAX_BATCH=2
LOCAL_MAX_NEW_TOKENS=384

# Model (unsloth/Phi-3-mini-4k-instruct is verified to train on the A5000;
# unsloth/Meta-Llama-3.1-8B-Instruct also works but is slower)
BASE_MODEL_ID=unsloth/Phi-3-mini-4k-instruct

# Autonomy: true = no approval prompts, the loop runs itself to the target/judge
# (good for unattended runs); false = TUI asks to approve evals + whether to keep training.
AUTO_APPROVE=false

# Voice/LiveKit (optional, off by default; needs `pip install livekit`-style extras)
VOICE_ENABLED=false
# LiveKit — get from cloud.livekit.io (project settings)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Gemini — get from aistudio.google.com/api-keys (use non-supervised Google account)
GOOGLE_API_KEY=

# MiniMax — get from platform.minimax.io/user-center/basic-information
MINIMAX_GROUP_ID=
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7-highspeed
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Remote GPU VM - blank SSH values keep config push in dry-run and runner in mock fallback
TRAINING_BACKEND=mock
MODEL_RUNNER=mock
SSH_HOST=
SSH_USER=
SSH_PORT=22
SSH_KEY_PATH=
# Hosted web app only: the private key's contents, written to a temp file when SSH_KEY_PATH is unset
SSH_PRIVATE_KEY=
REMOTE_CONFIG_PATH=/workspace/config.json
REMOTE_RESULTS_PATH=/workspace/generations/results.json

# Web app caps (the public site spends your API credits)
WEB_MAX_ITERATIONS=3
WEB_MAX_TRAINING_SAMPLES=50
WEB_RUNS_PER_IP_PER_HOUR=10
WEB_MAX_CONCURRENT_RUNS=3

# DigitalOcean — claim $200 credits at the DO table (QR code) on-site
DIGITALOCEAN_TOKEN=
DIGITAL_OCEAN_MODEL_ACCESS_KEY=
DIGITAL_OCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run/v1/
DIGITAL_OCEAN_JUDGE_MODEL=llama3.3-70b-instruct

# MongoDB Atlas — invite sent to attendees separately
MONGODB_URI=
MONGODB_DB_NAME=evolora
MONGODB_RUNS_COLLECTION=runs
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
